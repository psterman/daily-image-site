{
  "name": "daily-image-site",
  "version": "1.0.0",
  "description": "把每天收集到的图片，自动做成一个能在微信里直接打开的公开网页：抓取 → 清洗 → 构建 → 审稿 → 发布，附 RSS 订阅、OG 分享卡片、模糊占位和 38 套自动化护栏。",
  "license": "MIT",
  "author": "psterman",
  "repository": {
    "type": "git",
    "url": "https://github.com/psterman/daily-image-site.git"
  },
  "homepage": "https://github.com/psterman/daily-image-site#readme",
  "keywords": [
    "static-site",
    "cloudflare-pages",
    "r2",
    "rss",
    "og-image",
    "image-gallery"
  ],
  "scripts": {
    "test": "node tools/run-all-tests.mjs",
    "test:mutate": "node tools/run-all-tests.mjs --mutate",
    "test:digest": "node tools/test-digest.mjs",
    "db:check": "node tools/check-data-model.mjs",
    "platform:test": "node tools/test-platform-flow.mjs",
    "platform:run": "node tools/platform-cli.mjs",
    "platform:ingest": "node tools/ingest-platform.mjs",
    "platform:ingest-visual": "node tools/ingest-visual-packs.mjs",
    "platform:repair": "node tools/repair-shared-pool.mjs",
    "platform:daily": "node tools/daily-platform-run.mjs",
    "platform:coverage": "node tools/report-ingest-coverage.mjs",
    "sb:check": "node tools/check-supabase.mjs",
    "build": "node tools/build.mjs",
    "digest": "node tools/build-digest.mjs",
    "mail:render": "node tools/render-email.mjs",
    "mail:send": "node tools/send-newsletter.mjs",
    "groupbot:render": "node tools/render-groupbot.mjs",
    "groupbot:send": "node tools/send-groupbot.mjs",
    "preview": "node tools/preview-server.mjs",
    "fulltext:dev": "node tools/fulltext-dev.mjs",
    "test:fulltext": "node tools/test-extract-article.mjs && node tools/test-fulltext-fetch.mjs",
    "test:format-catalog": "node tools/test-format-catalog.mjs",
    "format:catalog": "node tools/build-format-catalog.mjs",
    "format:catalog:cache": "node tools/build-format-catalog.mjs --from-cache",
    "format:expand": "node tools/expand-rss-from-catalog.mjs",
    "format:sources": "node tools/build-source-catalog.mjs",
    "test:bestblogs-taxonomy": "node tools/test-bestblogs-taxonomy.mjs",
    "test:source-catalog": "node tools/test-source-catalog.mjs",
    "review": "node tools/start-review.mjs"
  },
  "devDependencies": {
    "playwright": "1.59.1"
  }
}
