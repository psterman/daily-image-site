# ===========================================================================
# 环境变量模板（可提交到 git，因为不含真实凭证）
# 真实值放 .env.local —— 已被 .gitignore 忽略，绝不入库
# ===========================================================================

# --- Supabase（控制面 / 业务真源） ---
# Project Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# 新版 publishable key（公开，受 RLS 约束，可进前端）
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 业务表所在的 schema（本项目装在独立的 platform schema，与既有 public 表隔离）
# 浏览器客户端会自动加 Accept-Profile / Content-Profile 头
SUPABASE_SCHEMA=platform

# 旧版 anon key（向后兼容；与 publishable key 二选一即可）
SUPABASE_ANON_KEY=sbp_xxx

# 高危：service_role / secret key，绕过 RLS。
# 只允许服务端 Edge Function 使用，绝不进前端代码、绝不入库、绝不进日志。
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# 数据库连接串，仅本地初始化时跑 SQL 用一次（db/schema.sql 等）
SUPABASE_DB_URL=postgresql://postgres:xxx@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Cloudflare（发布面 / 文件面） ---
CLOUDFLARE_ACCOUNT_ID=xxxxxxxx
CLOUDFLARE_API_TOKEN=yyyyyyyy
PAGES_PROJECT=your-project
R2_BUCKET=your-bucket
SITE_URL=https://your-project.pages.dev

# --- 可选：Newsletter（Resend）---
RESEND_API_KEY=re_xxx
NEWSLETTER_FROM=Your Name <hello@yourdomain.com>

# --- 可选：群机器人 webhook ---
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
