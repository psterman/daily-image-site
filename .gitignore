# 凭据（绝不入库）
.env.local
.env
*.pem

# 图片 URL 的随机盐 —— 泄露它就等于泄露全部图片路径，不要入库
.img-salt

# 审稿放行凭证（每天一个，审完就过期）
.review-passed-*

# 审稿台实际占用的端口（端口占用时自动顺延，写下来给一键脚本用）
.review-port

# 本次要发布的日期（daily.ps1 写的，publish.ps1 读它）
.publish-date

# 转码产物与页面产物（每日重新生成）
r2/
published/

# 验证截图
.verify/

# 运行期日志 / 状态文件（每天都在变，且含本机路径）
*.log
*.out
*.err
*.pid
*.done
.fetch-ledger.json
.daily-review.lock
.probe-night-invoke.log

# 依赖
node_modules/

# 临时工程目录（测试脚本的沙盒，用完即删）
.tmp-*
.tmp-*/

# 格式目录探针缓存（可重建）
tools/.cache/

# Python 侧
__pycache__/
*.pyc

# 抓取器自动下载的模型（22 万字节，第一次跑会自己下载）
tools/grab/models/
*.onnx

# 任务台（定时任务 GUI）的运行时文件
.night-dashboard-port
.night-dashboard.pid
.night-dashboard.out.log
.night-dashboard.err.log

# pHash 增量缓存（2026-11-25 加）
# 它是**本机加速器**，每晚会重写；进仓库只会制造无意义的 diff。
.phash-cache.json
.phash-cache.json.tmp

# 看门狗（2026-11-25 加）的控制台日志 + 轮转产生的历史
.night-watchdog-console.log
.night-watchdog-console.log.*
.night-publish-console.log.*
.daily-review.log.*
